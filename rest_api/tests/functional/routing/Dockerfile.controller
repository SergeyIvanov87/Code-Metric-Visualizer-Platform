# syntax=docker/dockerfile:1
FROM test_pseudo_fs
COPY --chmod=0644 fs_api_proxy/http_api_gateway/controller.py /gateway-controller.py
RUN mkdir -p /var/lib/http-api-gateway && chown nobody:nobody /var/lib/http-api-gateway
USER nobody
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/gateway-controller.py"]
