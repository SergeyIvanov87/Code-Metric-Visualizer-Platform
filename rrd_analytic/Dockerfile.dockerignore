# Paths are relative to the repository-root build context.
# This file takes precedence over the root .dockerignore for this Dockerfile.
# Allow only local COPY/ADD inputs; update when those instructions change.
**

# SCRIPT_GEN_LOC defaults to services; allowlist any custom location too.
!common/
common/**
!common/modules/
!common/modules/**
!common/shell_utils/
!common/shell_utils/**
!common/api_management.py
!common/build_api_executors.py
!common/build_api_services.py
!common/build_api_pseudo_fs.py
!common/build_common_api_services.py
!common/canonize_internal_api.py
!common/check_missing_pseudo_fs_from_schema.py
!common/get_service_api_deps.py
!common/make_api_readme.py
!common/renew_pseudo_fs_pipes.py
!rrd_analytic/
rrd_analytic/**
!rrd_analytic/*.sh
!rrd_analytic/*.py
!rrd_analytic/API/
!rrd_analytic/API/**
!rrd_analytic/services/
rrd_analytic/services/**
!rrd_analytic/services/*.sh

# Exclude local secrets and generated files within allowed directories.
**/.env
**/.env.*
**/.git
**/__pycache__
**/*.pyc
**/.cache
**/.config
**/.chroma
**/.local
